{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoUpdatesChannel": "latest",
  "permissions": {
    "allow": [
      "Bash(gh issue:*)",
      "WebFetch(domain:github.com)"
    ]
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Thinking"
    ]
  },
  "tui": "fullscreen",
  "respondToBashCommands": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark"
}
